# Paperclip environment configuration
# Copy this file to .env and fill in the required values before running
# docker compose up (or the dev server).

# ─── Required ────────────────────────────────────────────────────────────────

# Auth secret — generate with: openssl rand -hex 32
# MUST be set to a random value; never commit the real secret.
BETTER_AUTH_SECRET=changeme-replace-with-a-random-secret

# ─── Database (docker compose only) ─────────────────────────────────────────

# PostgreSQL credentials used by the db service and the server's DATABASE_URL.
# Defaults are fine for local development; change for production.
POSTGRES_USER=paperclip
POSTGRES_PASSWORD=paperclip
POSTGRES_DB=paperclip

# ─── Optional ────────────────────────────────────────────────────────────────

# Dev server / local process (not used by Docker Compose — overridden there)
DATABASE_URL=postgres://paperclip:paperclip@localhost:5432/paperclip
PORT=3100
SERVE_UI=false

# Override the host port Docker Compose exposes (default: 3100)
# PAPERCLIP_PORT=3100

# Override the public URL used for auth callbacks and invite links.
# Set this when running behind a reverse proxy or on a non-localhost address.
# PAPERCLIP_PUBLIC_URL=http://localhost:3100

# Deployment mode: "authenticated" (default) or "local_trusted"
# PAPERCLIP_DEPLOYMENT_MODE=authenticated
# PAPERCLIP_DEPLOYMENT_EXPOSURE=private

# LLM provider keys — required only if you use local adapters inside Docker
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
